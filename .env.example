SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-side service credential used only for signed external-engine event ingress.
# Prefer the modern Supabase secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# External Execution OS HOS boundary.
EXECUTION_OS_BASE_URL=
HOS_EXECUTION_SHARED_SECRET=
HOS_EXECUTION_TENANT_ID=personal-hos
HOS_DEFAULT_TIMEZONE=UTC

# Execution OS must point its HOS_EVENT_MESH_URL to:
# https://<your-humankernelos-host>/api/v1/external-engines/execution-os/events

# Production activation controls.
# Set true only when Execution OS is a required production dependency.
HOS_REQUIRE_EXECUTION_OS=false

# Durable external-engine ingress limits.
HOS_EXTERNAL_INGRESS_MAX_BYTES=262144
HOS_EXTERNAL_INGRESS_RATE_PER_MINUTE=120

# Production certification evidence. These are timestamps of completed,
# independently verified operational checks; do not set them speculatively.
HOS_BACKUP_VERIFIED_AT=
HOS_RESTORE_DRILL_VERIFIED_AT=

# Supabase legacy fallback. Prefer SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=
