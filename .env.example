SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-side service credential used only for signed external-engine event ingress.
# Prefer the modern Supabase secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# External Execution OS HOS boundary.
EXECUTION_OS_BASE_URL=
HOS_EXECUTION_SHARED_SECRET=
HOS_EXECUTION_TENANT_ID=personal-hos
HOS_DEFAULT_TIMEZONE=UTC

# Execution OS must point its HOS_EVENT_MESH_URL to:
# https://<your-humankernelos-host>/api/v1/external-engines/execution-os/events
