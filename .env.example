# ---------------------------------------------------------------------------
# Local development — plain PostgreSQL (default)
# ---------------------------------------------------------------------------
DATABASE_PROVIDER=postgres
VITE_DATABASE_PROVIDER=postgres

POSTGRES_DB_NAME=humankernelos
POSTGRES_APP_USER=hos_user
POSTGRES_APP_PASSWORD=hos_local_password
DATABASE_URL=postgresql://hos_user:hos_local_password@127.0.0.1:5432/humankernelos
POSTGRES_POOL_MAX=10

# Stable single-user local development identity.
# Production must use a real identity provider; local auth is rejected in NODE_ENV=production.
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_USER_EMAIL=local@humankernelos.test
VITE_LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
VITE_LOCAL_USER_EMAIL=local@humankernelos.test

# ---------------------------------------------------------------------------
# Optional hosted Supabase mode
# Set DATABASE_PROVIDER=supabase and VITE_DATABASE_PROVIDER=supabase to use it.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-side service credential used only for trusted server operations.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External Execution OS HOS boundary.
EXECUTION_OS_BASE_URL=
HOS_EXECUTION_SHARED_SECRET=
HOS_EXECUTION_TENANT_ID=personal-hos
HOS_DEFAULT_TIMEZONE=Africa/Nairobi

# Execution OS must point its HOS_EVENT_MESH_URL to:
# http://localhost:<hos-port>/api/v1/external-engines/execution-os/events
# (HTTPS is required in production.)

# Production activation controls.
HOS_REQUIRE_EXECUTION_OS=false

# Durable external-engine ingress limits.
HOS_EXTERNAL_INGRESS_MAX_BYTES=262144
HOS_EXTERNAL_INGRESS_RATE_PER_MINUTE=120

# Production certification evidence. Do not set these speculatively.
HOS_BACKUP_VERIFIED_AT=
HOS_RESTORE_DRILL_VERIFIED_AT=
